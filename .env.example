# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel Blob token (automatically injected when Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Admin account
ADMIN_USERNAME=admin
# Create with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=

# Random secret, 32+ characters recommended
SESSION_SECRET=replace-with-a-long-random-secret
